# Transcription (required for the engine)
OPENAI_API_KEY=

# Coach layer (optional: recordings return metrics without it)
ANTHROPIC_API_KEY=

# Where confirmation and password-reset links come back to. Set this in
# Vercel or the links resolve to whatever origin sent them (docs/email.md).
NEXT_PUBLIC_SITE_URL=https://speakethos.com

# Persistence (optional: recordings analyze without it, just aren't stored)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Premium unlock code (/api/redeem). Unset = codes are off (503).
# Long and random, never a word: the route's rate limits slow guessing,
# they don't stop it. `openssl rand -base64 18` is plenty.
PREMIUM_UNLOCK_CODE=

# Tester mode's code (/api/tester, docs/testers.md). Unset = 1234,
# Timothy's pick for the friends testing the scores. It only switches on
# the match check and its consent; it grants no Premium, so a weak code
# costs nothing. Change it to stop new testers joining.
TESTER_CODE=

# Premium's price ladder (lib/billing.ts). Run scripts/stripe-setup.mjs
# once per mode; it prints the values below. Unset = billing routes 503.
STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret; billing stays off without it.
STRIPE_WEBHOOK_SECRET=
# Optional: the portal configuration the setup script made (bpc_...).
STRIPE_PORTAL_CONFIGURATION=
# 1 switches the paywall's checkout on; leave unset until the keys are in.
NEXT_PUBLIC_CHECKOUT_OPEN=

# Web push (DECISIONS #186). Generate the pair once with:
#   npx web-push generate-vapid-keys
# Public key ships to the browser; private key stays server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@speakethos.com

# Shared secret between the scheduler (GitHub Actions push-cron.yml,
# repo secret of the same name) and /api/push/cron.
CRON_SECRET=
